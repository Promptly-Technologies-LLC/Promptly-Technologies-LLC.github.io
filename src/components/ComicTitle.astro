---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

interface Props {
  accessibleText?: string;
  /** Use h1 on the home page; use p on subpages that already have their own h1. */
  asPageHeading?: boolean;
  /** Fill the parent. The parent supplies the lockup width. */
  uncapped?: boolean;
}

const spokenName = Astro.props.accessibleText ?? 'Promptly Technologies';
const asPageHeading = Astro.props.asPageHeading ?? true;
const uncapped = Astro.props.uncapped ?? false;

/**
 * Inline a wordmark file. Ids are prefixed because the stacked and wide
 * lockups are both in the page, and an XML declaration is not valid in HTML.
 * The visible paths stay hidden from assistive tech; the heading above is the name.
 */
function inlineWordmark(filename: string, prefix: string): string {
  const source = readFileSync(fileURLToPath(new URL(`../../public/images/${filename}`, import.meta.url)), 'utf8');
  return source
    .replace(/<\?xml[^?]*\?>\s*/i, '')
    .replaceAll('id="halftone"', `id="${prefix}-halftone"`)
    .replaceAll('url(#halftone)', `url(#${prefix}-halftone)`)
    .replaceAll('id="title"', `id="${prefix}-title"`)
    .replaceAll('aria-labelledby="title"', `aria-labelledby="${prefix}-title"`)
    .replace(
      '<svg ',
      '<svg class="block h-auto w-full" width="100%" aria-hidden="true" focusable="false" ',
    );
}

const stackedWordmark = inlineWordmark('logo.svg', 'logo-stacked');
const wideWordmark = inlineWordmark('logo-wide.svg', 'logo-wide');
---

<div class="w-full">
  {asPageHeading ? <h1 class="sr-only">{spokenName}</h1> : <p class="sr-only">{spokenName}</p>}
  <div class:list={['mx-auto block w-full md:hidden', uncapped ? '' : 'max-w-3xl px-4']} set:html={stackedWordmark} />
  <div class:list={['mx-auto hidden w-full md:block', uncapped ? '' : 'max-w-5xl px-6']} set:html={wideWordmark} />
</div>
