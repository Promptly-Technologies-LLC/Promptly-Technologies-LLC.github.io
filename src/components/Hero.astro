---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import './Hero.css';
import heroJSON from '../customizations/hero.json';
import propertiesJSON from '../customizations/siteproperties.json';
import iconsJSON from '../customizations/socialicons.json';
import ComicTitle from './ComicTitle.astro';
import Nav from './Nav.astro';
import ScallopedOval from './ScallopedOval.astro';
import SocialIcon from './SocialIcon.astro';

const hero = heroJSON;
const properties = propertiesJSON;
/** Glyph outlines in icon order, so the seal can keep its grain off them. */
const stamps = Object.keys(properties.socialProfiles).map(
  (key) => (iconsJSON as Record<string, string>)[key],
);

/** Width ÷ height of a WebP in `public`, so the hero frame can match the artwork. */
function webpAspect(publicPath: string): number {
  const file = fileURLToPath(new URL(`../../public/${publicPath}`, import.meta.url));
  const { width, height } = readWebpSize(readFileSync(file), publicPath);
  return width / height;
}

/**
 * Canvas size of a VP8, VP8L, or VP8X WebP.
 * Other containers are rejected so a bad asset fails the build.
 */
function readWebpSize(buf: Buffer, publicPath: string): { width: number; height: number } {
  const reject = (reason: string): never => {
    throw new Error(`${publicPath}: ${reason}`);
  };

  if (buf.length < 12 || buf.toString('ascii', 0, 4) !== 'RIFF' || buf.toString('ascii', 8, 12) !== 'WEBP') {
    reject('not a WebP file');
  }

  let offset = 12;
  while (offset + 8 <= buf.length) {
    const tag = buf.toString('ascii', offset, offset + 4);
    const size = buf.readUInt32LE(offset + 4);
    const payload = offset + 8;
    if (payload + size > buf.length) reject('truncated WebP chunk');

    if (tag === 'VP8X' && size >= 10) {
      return {
        width: 1 + buf.readUIntLE(payload + 4, 3),
        height: 1 + buf.readUIntLE(payload + 7, 3),
      };
    }

    if (tag === 'VP8 ' && size >= 10) {
      if (buf.toString('hex', payload + 3, payload + 6) !== '9d012a') reject('not a VP8 keyframe');
      return {
        width: buf.readUInt16LE(payload + 6) & 0x3fff,
        height: buf.readUInt16LE(payload + 8) & 0x3fff,
      };
    }

    if (tag === 'VP8L' && size >= 5 && buf[payload] === 0x2f) {
      const bits = buf.readUInt32LE(payload + 1);
      return {
        width: (bits & 0x3fff) + 1,
        height: ((bits >>> 14) & 0x3fff) + 1,
      };
    }

    offset = payload + size + (size & 1);
  }

  return reject('no readable canvas size');
}

/** A plate at several widths: `${src}-${width}.{avif,webp}` in public/images. */
interface Plate {
  src: string;
  widths: number[];
}
const plateSrcset = (plate: Plate, ext: string) =>
  plate.widths.map((w) => `${plate.src}-${w}.${ext} ${w}w`).join(', ');
const plateAspect = (plate: Plate) =>
  webpAspect(`${plate.src}-${plate.widths[plate.widths.length - 1]}.webp`);

/** Wide plate from 768px up; a portrait plate below, so phones get a taller frame. */
const wide: Plate = hero;
const narrow: Plate = hero.mobile;
const wideAspect = plateAspect(wide);
const narrowAspect = plateAspect(narrow);
/** The frame is the largest box of this aspect that fits the viewport. */
const framed = (aspect: number) => `min(100vw, calc(100svh * ${aspect}))`;
---

<section id="hero" class="hero-container" style={`--hero-aspect-wide: ${wideAspect}; --hero-aspect-narrow: ${narrowAspect}`}>
  <div class="top-content-wrapper">
    <div class="comic-title">
      <ComicTitle />
    </div>
    <div class="inline-flex nav-wrapper">
      <Nav />
    </div>
  </div>
  <div class="hero-frame">
    <picture class="hero-picture">
      <source type="image/avif" media="(max-width: 767px)" srcset={plateSrcset(narrow, 'avif')} sizes={framed(narrowAspect)} />
      <source type="image/webp" media="(max-width: 767px)" srcset={plateSrcset(narrow, 'webp')} sizes={framed(narrowAspect)} />
      <source type="image/avif" srcset={plateSrcset(wide, 'avif')} sizes={framed(wideAspect)} />
      <source type="image/webp" srcset={plateSrcset(wide, 'webp')} sizes={framed(wideAspect)} />
      <img class="hero-image" src={`${wide.src}-${wide.widths[1]}.webp`} alt={hero.alt} />
    </picture>
  </div>
  <div class="bottom-container">
    <div class="bottom-column">
      <div class="bottomwrapper">
        <ScallopedOval stamps={stamps}>
          <div class="social-icons">
            {
              Object.entries(properties.socialProfiles).map(([key, value]) => (
                <SocialIcon iconName={key} url={value} class="icon-link" />
              ))
            }
          </div>
        </ScallopedOval>
      </div>
    </div>
  </div>
</section>

