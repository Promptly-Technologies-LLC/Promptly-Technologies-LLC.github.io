---
import './Nav.css';
import { sectionNavLinks } from '../data/navLinks';

const midpoint = Math.ceil(sectionNavLinks.length / 2);
const linkGroups = [sectionNavLinks.slice(0, midpoint), sectionNavLinks.slice(midpoint)];
---

<nav class="cover-nav" aria-label="Cover">
  {linkGroups.map((group, index) => (
    <>
      {index > 0 && <span class="cover-nav-gap" aria-hidden="true"></span>}
      <div class:list={['cover-nav-group', index === 0 ? 'is-leading' : 'is-trailing']}>
        {group.map(({ href, label }) => (
          <a href={href} class:list={['cover-nav-link', { 'cover-nav-section': href.includes('#') }]}>{label}</a>
        ))}
      </div>
    </>
  ))}
</nav>
